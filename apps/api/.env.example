# 复制为 apps/api/.env 后按需修改（Node 22 的 --env-file 或 shell 导出都可用）

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# ---------- 数据库 ----------
# 本地 SQLite 文件（libSQL 驱动）；相对路径相对于 apps/api/
DATABASE_URL=file:./data/daybook.sqlite

# ---------- 鉴权（better-auth） ----------
# 生产环境必须换成足够长的随机串，否则启动会被 assertProdConfig 拦下
BETTER_AUTH_SECRET={{SECRET_qgjtww2o}}-to-a-long-random-string
BETTER_AUTH_URL=http://127.0.0.1:3001

# 允许的前端来源，逗号分隔（CORS + better-auth trustedOrigins）
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---------- 开发便利 ----------
# 1 = 把找回密码的重置令牌随 /api/auth/forgot-password 响应返回（本地无 SMTP 也能跑通找回闭环）
# 生产环境必须设为 0，否则启动会被 assertProdConfig 拦下（旧变量名 EXPOSE_DEV_OTP 仍兼容）
EXPOSE_DEV_AUTH=1

# ---------- 同步 ----------
# 单次 push 允许的最大变更条数
MAX_PUSH_BATCH=2000
