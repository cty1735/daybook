{
  "name": "@daybook/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "日账 DayBook 后端：Hono + Drizzle + SQLite（libSQL） + better-auth + 增量同步",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@daybook/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2"
  }
}